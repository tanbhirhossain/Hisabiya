Set-Content .gitignore -Value @"
# Environment and local configurations
.env
.env.local
.env.*.local
.phpunit.result.cache

# Dependencies
/node_modules
/vendor

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build and OS outputs
/public/build
/public/storage
/storage/*.key
.DS_Store
Thumbs.db
"@; git add .gitignore; git commit -m "chore: add production standard gitignore configuration"; git push origin master
